# =============================================================================
# Contoh konfigurasi environment — salin menjadi `.env` lalu isi nilainya.
# JANGAN commit file `.env` yang berisi nilai asli.
# =============================================================================

# --- Database (Neon PostgreSQL) ---------------------------------------------
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Autentikasi -------------------------------------------------------------
# WAJIB diset di production. Minimal 16 karakter acak, contoh cara membuat:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Dipakai untuk menandatangani bearer token dan mengenkripsi keyHint (escrow).
AUTH_SECRET=""

# --- SMTP Mailtrap (opsional, untuk OTP reset password & pemulihan kunci) ----
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT="2525"
MAILTRAP_USER=""
MAILTRAP_PASS=""
MAILTRAP_SENDER_NAME="Blowfish E-KTP Security System"
MAILTRAP_SENDER_EMAIL="security@blowfish-ktp.id"

# --- Seeder admin (opsional) -------------------------------------------------
# Akun admin hanya dibuat jika kedua variabel ini diisi.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator Sistem"
SEED_ADMIN_USERNAME="admin"
