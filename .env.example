# =========================================================================
# NEON POSTGRESQL DATABASE & BACKEND ENVIRONMENT VARIABLES (EXAMPLE)
# =========================================================================

# URL Koneksi PostgreSQL Neon Cloud (Serverless Pooler)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct URL untuk migrasi / DDL push
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxxxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# SMTP Mailtrap Configuration
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT="2525"
MAILTRAP_USER="YOUR_MAILTRAP_USER"
MAILTRAP_PASS="YOUR_MAILTRAP_PASSWORD"
MAILTRAP_SENDER_EMAIL="security@blowfish-ktp.id"
MAILTRAP_SENDER_NAME="Blowfish E-KTP Security System"

# Application Environment
NODE_ENV="development"
